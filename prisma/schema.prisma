// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. ПОЛЬЗОВАТЕЛИ (Единый профиль для всей экосистемы)
model User {
  id        Int      @id @default(autoincrement())
  telegramId BigInt   @unique
  username  String?
  firstName String?
  language  String   @default("ru")
  createdAt DateTime @default(now())

  wallet    Wallet?
  orders    Order[]
  bookings  Booking[]
}

// 2. КОШЕЛЕК (Единый баланс: фиат + крипта + бонусы)
model Wallet {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balanceUsd  Float    @default(0.0)
  balanceTon  Float    @default(0.0)
  bonusPoints Int      @default(0)
  updatedAt   DateTime @updatedAt
}

// 3. ТОВАРЫ (Китай, электроника, услуги)
model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  priceUsd    Float
  category    String   // "china_electronics", "china_clothing", "tourism_service"
  imageUrl    String?
  supplierUrl String?  // Ссылка на 1688/Taobao для будущего парсинга
  createdAt   DateTime @default(now())

  orders      Order[]
}

// 4. ЗАКАЗЫ И ЛОГИСТИКА (Объединены для простоты и скорости MVP)
model Order {
  id                Int      @id @default(autoincrement())
  userId            Int
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId         Int
  product           Product  @relation(fields: [productId], references: [id])
  
  status            String   @default("PENDING") // PENDING, PAID, PROCESSING, SHIPPED, DELIVERED
  trackingNumber    String?  // Трек-номер для логистики
  logisticsStatus   String?  // "На складе в Китае", "На таможне", "В пути", "Доставлен"
  
  totalAmountUsd    Float
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// 5. ТУРИЗМ (Бронирования туров, отелей, гидов)
model Booking {
  id             Int      @id @default(autoincrement())
  userId         Int
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String   // Название тура или услуги
  description    String?
  date           DateTime // Дата начала
  status         String   @default("PENDING") // PENDING, CONFIRMED, CANCELLED, COMPLETED
  totalAmountUsd Float
  createdAt      DateTime @default(now())
}
